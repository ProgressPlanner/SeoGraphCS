{
	"name": "progressplanner/seographcs",
	"description": "The reusable PHP_CodeSniffer standard for SEO Graph projects.",
	"license": "GPL-2.0-or-later",
	"type": "phpcodesniffer-standard",
	"require": {
		"php": ">=8.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"wp-coding-standards/wpcs": "^3.2"
	},
	"require-dev": {
		"php-stubs/wordpress-stubs": "^6.7",
		"phpstan/phpstan": "^2.1",
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"SeoGraphCS\\": "SeoGraphCS/"
		}
	},
	"scripts": {
		"check": [
			"@quality",
			"@test"
		],
		"test": "phpunit",
		"quality": [
			"composer validate --strict",
			"phpcs"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	}
}
